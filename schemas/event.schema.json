{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reli4ble.github.io/fitnessclub-results/schemas/event.schema.json",
  "title": "Fitnessclub event data",
  "type": "object",
  "required": ["event", "stations", "teams"],
  "properties": {
    "event": {
      "type": "object",
      "required": ["id", "name", "date"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "date": {"type": "string", "format": "date"},
        "location": {"type": "string"},
        "status": {"type": "string"},
        "ageGroupsAvailable": {"type": "boolean"},
        "notice": {"type": "string"}
      },
      "additionalProperties": true
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "name", "unit", "direction"],
        "properties": {
          "key": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9]*$"},
          "name": {"type": "string", "minLength": 1},
          "shortName": {"type": "string"},
          "unit": {"type": "string", "minLength": 1},
          "direction": {"enum": ["asc", "desc"]}
        },
        "additionalProperties": true
      }
    },
    "teams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "division", "partner1", "partner2", "results"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "division": {"enum": ["Männer", "Frauen", "Mixed"]},
          "partner1": {"type": "string", "minLength": 1},
          "partner2": {"type": "string", "minLength": 1},
          "age1": {"type": ["number", "null"], "minimum": 0},
          "age2": {"type": ["number", "null"], "minimum": 0},
          "averageAge": {"type": ["number", "null"], "minimum": 0},
          "ageGroup": {"type": ["string", "null"]},
          "results": {
            "type": "object",
            "minProperties": 1,
            "patternProperties": {"^[A-Za-z][A-Za-z0-9]*$": {"type": "number", "minimum": 0}},
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}